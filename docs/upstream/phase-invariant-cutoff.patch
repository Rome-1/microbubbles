+def _temporal_gram(matrix: np.ndarray, subtract_mean: bool = True,
+                   chunk: int = 300_000) -> np.ndarray:
+    """Mean-subtracted temporal Gram ``x xᴴ`` accumulated in complex128.
+
+    Accumulating the small (frames, frames) Gram from complex64 chunks keeps the
+    decomposition in double precision without ever materialising a complex128 copy
+    of the (frames, voxels) matrix -- that copy is 16 bytes/voxel-frame (~24 GB for
+    a 700-frame in-vivo acquisition), which undoes the streaming memory work.
+    """
+    n_frames = int(matrix.shape[0])
+    mean = matrix.mean(axis=0, keepdims=True) if subtract_mean else None
+    gram = np.zeros((n_frames, n_frames), dtype=np.complex128)
+    for start in range(0, matrix.shape[1], chunk):
+        block = matrix[:, start:start + chunk]
+        if mean is not None:
+            block = block - mean
+        block = block.astype(np.complex128)
+        gram += block @ block.conj().T
+    return gram
+
+
+def mode_centroids(u: np.ndarray, frame_rate_hz: float) -> np.ndarray:
+    """Power-weighted mean |frequency| (Hz) of each temporal mode in ``u``.
+
+    Uses the full complex spectrum, so the value depends only on the mode itself and
+    not on the unit phase an eigensolver happened to attach to it (see #2 and the
+    note in ``spectral_centroid_cutoff``).
+    """
+    n_frames = int(u.shape[0])
+    freqs = np.abs(np.fft.fftfreq(n_frames, d=1.0 / frame_rate_hz))
+    spectrum = np.abs(np.fft.fft(u, axis=0)) ** 2   # (frames, modes)
+    spectrum[0, :] = 0.0                            # exclude DC
+    total = spectrum.sum(axis=0)
+    return (freqs[:, None] * spectrum).sum(axis=0) / np.where(total > 0, total, 1.0)
+
+
